# Bu dosyayı .env olarak kopyalayın. Gerçek değerleri yalnızca sunucuda girin.
TELEGRAM_TOKEN=
BOT_PASSWORD=
ADMIN_PASSWORD=
ADMIN_IDS=
# SESSION_SECRET boşsa data/session.key güvenli rastgele oluşturulur.
SESSION_SECRET=
# Python yerel kullanım. Docker Compose veri dizinini /data olarak sabitler.
PANEL_VERI=./data
DINLE=127.0.0.1
PORT=8080
# HTTPS reverse proxy ile kullanımda 1, HTTP yerel testte 0.
HTTPS=0
TZ=Europe/Istanbul

# Sadece backend portu loopback/korumalı ağda, Nginx varsa 1. Doğrudan açık portta 0.
TRUST_PROXY=0

# İsteğe bağlı; boşsa doğrudan görsel kaydı sorunsuz devam eder.
GYAZO_TOKEN=
# Eski kullanıcı onayı farklı botta ilk parola girişini atlamaz.
# Telegram normal alan mesajlarını temizlemek ek ağ isteği doğurur; hız için 0.
TELEGRAM_CLEANUP=0
