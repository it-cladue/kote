# Bu dosyayı .env olarak kopyalayın. Gerçek değerleri yalnızca sunucuda girin.
TELEGRAM_TOKEN=
# BOT_PASSWORD ve ADMIN_PASSWORD en az 8 karakter olsun (kısa değerde bot açılışta uyarı yazar; günlük maskelemesi 6 karakterden kısa değerleri gizlemez).
BOT_PASSWORD=
ADMIN_PASSWORD=
ADMIN_IDS=
# SESSION_SECRET boşsa data/session.key güvenli rastgele oluşturulur.
SESSION_SECRET=
# Python yerel kullanım. Docker Compose veri dizinini /data olarak sabitler.
PANEL_VERI=./data
DINLE=127.0.0.1
PORT=8080
# HTTPS reverse proxy ile kullanımda 1, HTTP yerel testte 0.
HTTPS=0
TZ=Europe/Istanbul

# Sadece backend portu loopback/korumalı ağda, Nginx varsa 1. Doğrudan açık portta 0.
TRUST_PROXY=0

# İsteğe bağlı; boşsa doğrudan görsel kaydı sorunsuz devam eder.
GYAZO_TOKEN=
# Eski kullanıcı onayı farklı botta ilk parola girişini atlamaz.
# Telegram normal alan mesajlarını temizlemek ek ağ isteği doğurur; hız için 0.
TELEGRAM_CLEANUP=0

# ---- 2.3 ile gelen isteğe bağlı anahtarlar (yazılmazsa varsayılan geçerli) ----
# Host başlığı beyaz listesi (virgülle). Boşsa denetim yok. Doluysa 127.0.0.1 ve localhost kendiliğinden eklenir.
#GUVENILEN_HOSTLAR=217.156.123.36,panel.alanadi.com
# TRUST_PROXY=1 iken X-Forwarded-* başlıklarına güvenilen tek vekil (nginx aynı makinede).
#GUVENILEN_PROXY=127.0.0.1
# Oturum anahtarı döndürme: eski SESSION_SECRET değerleri (virgülle); 1-2 gün sonra silin.
#SESSION_SECRET_ESKI=
# Excel çıktısında tek dosyaya yazılacak en çok kayıt.
#CIKTI_SATIR_SINIRI=30000
# Görsel önbelleği sınırları (MB / gün; 0 = sınır yok). data/tmp/gyazo ve data/tmp/thumbs için.
#GYAZO_ONBELLEK_MB=2000
#GYAZO_ONBELLEK_GUN=0
#KUCUK_ONBELLEK_MB=300
# Bot: yanlış parola deneme sayısı (1-10).
#MAX_DENEME=3
# Bot: onaysız kişinin ilk görseli — parola (parola iste; aynı 20 sn içindeki fotoğraflar/albüm tek deneme, MAX_DENEME ayrı denemede engel) | engelle (eski davranış, hemen engel).
#BOT_YETKISIZ_GORSEL_POLITIKA=parola
# Bot: gönderim kuyruğu, yanıt sınırları, budama, günlük döndürme.
#BOT_OUTBOX_MAX_DENEME=5
#BOT_ENGELLI_UYARI_SANIYE=600
#BOT_PAROLA_ISTEM_SANIYE=20
#BOT_GUNLUK_SAKLAMA_GUN=30
#BOT_PENDING_SAKLAMA_SAAT=24
#BOT_LOG_MAX_MB=5
# Bot yönetici (/admin) parola istemi, deneme, kilit ve oturum süreleri (saniye).
#ADMIN_PROMPT_SANIYE=120
#ADMIN_MAX_DENEME=3
#ADMIN_KILIT_SANIYE=600
#ADMIN_OTURUM_SANIYE=1800
