# Kanit Merkezi ayarlari - bu dosya /opt/kanit/.env olarak durur, izni 600 (sahibi kanit), depoya girmez.
# Bicim: ANAHTAR=DEGER, # ile yorum. Degisiklikten sonra: systemctl restart kanit-web kanit-bot
# Ortam degiskeni (KANIT_ANAHTAR ya da ciplak ANAHTAR) bu dosyadaki degeri ezer (bkz. kanit/kanit/ayar.py).

# Veri koku: veritabani (kanit.db), gorseller/, onbellek/, yedek/, log/, gelen/
VERI=/opt/kanit/veri

# Web paneli. Alan adi + Plesk nginx arkasina alinca DINLE=127.0.0.1 yapin (bkz. deploy/nginx-plesk.md)
PORT=8080
DINLE=0.0.0.0
# Disa aktarma linklerinde kullanilacak adres; bos ise istekten alinir. Ornek: https://kanit.sirket.com
SITE_URL=

# Telegram botu. ILK KURULUMDA TEST BOTUNUN TOKEN'I; gecis bitince gercek token (bkz. ISLETME.md, gecis sirasi).
TELEGRAM_TOKEN=BURAYA_TELEGRAM_BOT_TOKEN
# Gyazo erisim token'i (gorsel cekme).
GYAZO_TOKEN=BURAYA_GYAZO_TOKEN
# Telegram uyelerinin bir kez yazdigi ortak sifre (Windows botundaki BOT_PASSWORD ile ayni olmali)
BOT_PASSWORD=BURAYA_UYE_SIFRESI
# Botun admin komutlarini (/durum, /bakim_ac ...) kullanabilecek Telegram ID'leri, virgulle: 123456,987654
ADMIN_IDS=

# Yanlis sifre deneme siniri (asilinca uye engellenir)
MAX_DENEME=3
# Telegram'dan kabul edilen en buyuk gorsel (MB)
MAX_GORSEL_MB=8
# Zaman dilimi (zaman damgalari yerel yazilir)
TZ=Europe/Istanbul

# Ters vekil (Plesk nginx / Cloudflare) arkasinda: 1 = X-Forwarded-For / CF-Connecting-IP basligina guven
GUVENILIR_PROXY=0
# 1 = oturum cerezi yalnizca https ile tasinir (alan adi + Let's Encrypt sonrasi)
HTTPS=0

# Oturum imza anahtari; bos ise VERI/gizli_anahtar.txt kendiliginden uretilir (onerilen: bos birakin)
SECRET_KEY=
# Log seviyesi: DEBUG, INFO, WARNING
LOG_SEVIYE=INFO
